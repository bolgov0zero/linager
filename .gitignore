# kickoff archive (contents live in docs/)
linager-kickoff.zip

# build output
/bin/
/dist/
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/
*.test
*.out

# local secrets and config
*.key
*.pem
.env
server.yaml
agent.yaml

# OS / editors
.DS_Store
.idea/
.vscode/

# site (VitePress): generated content and build output
/site/content/
/site/node_modules/
/site/.vitepress/cache/
/site/.vitepress/dist/

# desktop application (app/): the built interface is embedded, the dependencies are not kept
/app/frontend/dist/*
!/app/frontend/dist/.gitkeep
/app/frontend/node_modules/
/app/bin/
