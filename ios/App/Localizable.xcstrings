      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not known yet. The app will remember this certificate. Compare the fingerprint with the line “Fingerprint for iPhone and iPad” that the command linager server app-port prints on the server. The other line, “Certificate fingerprint”, belongs to another certificate and will not match. If your server prints only one line, update the server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер %@ ещё не известен. Приложение запомнит этот сертификат. Сверьте отпечаток со строкой «Fingerprint for iPhone and iPad», которую команда linager server app-port печатает на сервере. Другая строка, «Certificate fingerprint», относится к другому сертификату и не совпадёт. Если сервер печатает только одну строку, обновите сервер."
          }
        }
      }
